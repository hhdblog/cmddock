{
  "name": "cmdkit",
  "displayName": "Cmdkit",
  "description": "Group frequently used terminal commands and run them from the status bar. Ships with a library of 167 commands in 16 groups.",
  "version": "0.2.0",
  "publisher": "hhdblog",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "keywords": [
    "terminal",
    "commands",
    "status bar",
    "task runner",
    "productivity",
    "cli",
    "shell",
    "command palette",
    "workflow"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cmdkit.open",
        "title": "Commands",
        "category": "Cmdkit",
        "icon": "$(terminal)"
      },
      {
        "command": "cmdkit.search",
        "title": "Search All Commands",
        "category": "Cmdkit",
        "icon": "$(search)"
      },
      {
        "command": "cmdkit.runLast",
        "title": "Run Last Command Again",
        "category": "Cmdkit",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "cmdkit.reload",
        "title": "Reload File From Settings",
        "category": "Cmdkit",
        "icon": "$(refresh)"
      },
      {
        "command": "cmdkit.checkPlatform",
        "title": "Check Platform Compatibility",
        "category": "Cmdkit",
        "icon": "$(check)"
      },
      {
        "command": "cmdkit.export",
        "title": "Edit Command List",
        "category": "Cmdkit",
        "icon": "$(json)"
      },
      {
        "command": "cmdkit.import",
        "title": "Apply Command File",
        "category": "Cmdkit",
        "icon": "$(sync)"
      },
      {
        "command": "cmdkit.statusBarItems",
        "title": "Choose Status Bar Items",
        "category": "Cmdkit",
        "icon": "$(list-selection)"
      },
      {
        "command": "cmdkit.iconCatalog",
        "title": "Icon Catalog",
        "category": "Cmdkit",
        "icon": "$(paintcan)"
      },
      {
        "command": "cmdkit.addGroup",
        "title": "Add Built-in Group",
        "category": "Cmdkit",
        "icon": "$(new-folder)"
      },
      {
        "command": "cmdkit.removeGroup",
        "title": "Remove Group",
        "category": "Cmdkit",
        "icon": "$(trash)"
      },
      {
        "command": "cmdkit.usage",
        "title": "How to Use the Command File",
        "category": "Cmdkit",
        "icon": "$(markdown)"
      }
    ],
    "configurationDefaults": {
      "cmdkit.groups": [
        {
          "name": "Python",
          "icon": "$(snake)",
          "color": "#FFD43B",
          "commands": [
            {
              "name": "create venv",
              "command": "{python} -m venv .venv",
              "icon": "$(folder)",
              "description": "creates a virtual environment"
            },
            {
              "name": "install dependencies",
              "command": "{venv}pip install -r requirements.txt",
              "icon": "$(cloud-download)",
              "description": "install from requirements.txt"
            },
            {
              "name": "freeze to requirements.txt",
              "command": "{venv}pip freeze > requirements.txt",
              "icon": "$(archive)",
              "confirm": "requirements.txt will be overwritten. Continue?",
              "description": "writes the freeze output to a file"
            },
            {
              "name": "install package",
              "command": "{venv}pip install",
              "icon": "$(cloud-download)",
              "argsPrompt": "package name (e.g. requests==2.32.0)",
              "description": "installs a single package"
            },
            {
              "name": "run file",
              "command": "{venvpy}",
              "icon": "$(play)",
              "argsPrompt": "file path (e.g. main.py)",
              "description": "runs the given script"
            },
            {
              "name": "test",
              "command": "{venvpy} -m pytest",
              "icon": "$(beaker)",
              "description": "pytest"
            },
            {
              "name": "format",
              "command": "{venvpy} -m black .",
              "icon": "$(paintcan)",
              "description": "black"
            },
            {
              "name": "lint",
              "command": "{venvpy} -m ruff check .",
              "icon": "$(shield)",
              "description": "ruff"
            },
            {
              "name": "type check",
              "command": "{venvpy} -m mypy .",
              "icon": "$(symbol-key)",
              "description": "mypy"
            },
            {
              "name": "Jupyter Lab",
              "command": "{venv}jupyter lab",
              "icon": "$(book)",
              "description": "notebook server (Ctrl+C to stop)"
            },
            {
              "name": "list dependencies",
              "command": "{venv}pip list",
              "icon": "$(list-ordered)",
              "description": "installed packages"
            },
            {
              "name": "outdated",
              "command": "{venv}pip list --outdated",
              "icon": "$(clock)",
              "description": "outdated"
            }
          ]
        },
        {
          "name": "Flutter",
          "icon": "$(device-mobile)",
          "color": "#47C5FB",
          "commands": [
            {
              "name": "pub get",
              "command": "flutter pub get",
              "icon": "$(cloud-download)",
              "description": "download dependencies"
            },
            {
              "name": "run",
              "command": "flutter run",
              "icon": "$(play)",
              "description": "hot reload is on, Ctrl+C to stop"
            },
            {
              "name": "build apk",
              "command": "flutter build apk --release",
              "icon": "$(package)",
              "clear": true,
              "description": "APK output"
            },
            {
              "name": "build web",
              "command": "flutter build web",
              "icon": "$(globe)",
              "clear": true,
              "description": "web output"
            },
            {
              "name": "build ios",
              "command": "flutter build ios --release",
              "icon": "$(device-desktop)",
              "clear": true,
              "description": "requires macOS + Xcode"
            },
            {
              "name": "analyze",
              "command": "flutter analyze",
              "icon": "$(search)",
              "description": "static analysis"
            },
            {
              "name": "doctor",
              "command": "flutter doctor",
              "icon": "$(beaker)",
              "description": "checks the Flutter/Android/Xcode setup"
            },
            {
              "name": "doctor verbose",
              "command": "flutter doctor -v",
              "icon": "$(list-ordered)",
              "description": "the same check with full detail"
            },
            {
              "name": "test",
              "command": "flutter test",
              "icon": "$(beaker)",
              "description": "tests"
            },
            {
              "name": "format",
              "command": "dart format .",
              "icon": "$(paintcan)",
              "description": "dart formatter"
            },
            {
              "name": "devices",
              "command": "flutter devices",
              "icon": "$(device-mobile)",
              "description": "connected devices"
            },
            {
              "name": "clean",
              "command": "flutter clean",
              "icon": "$(discard)",
              "confirm": "The build cache will be deleted. Continue?",
              "description": "deletes the build directories"
            },
            {
              "name": "upgrade",
              "command": "flutter upgrade",
              "icon": "$(cloud-upload)",
              "description": "updates the SDK"
            },
            {
              "name": "upgrade force",
              "command": "flutter upgrade --force",
              "icon": "$(cloud-download)",
              "confirm": "Local changes in your Flutter checkout will be ERASED. This cannot be undone. Continue?",
              "description": "upgrade even with local changes — throws them away"
            },
            {
              "name": "stable channel",
              "command": "flutter channel stable && flutter upgrade",
              "icon": "$(sync)",
              "description": "switch to the channel and update"
            }
          ]
        },
        {
          "name": "Node.js",
          "icon": "$(server-environment)",
          "color": "#83CD29",
          "commands": [
            {
              "name": "install",
              "command": "npm install",
              "icon": "$(cloud-download)",
              "description": "install dependencies"
            },
            {
              "name": "clean install",
              "command": "npm ci",
              "icon": "$(cloud-download)",
              "clear": true,
              "description": "installs exactly from the lock file"
            },
            {
              "name": "build",
              "command": "npm run build",
              "icon": "$(tools)",
              "clear": true,
              "description": "production build"
            },
            {
              "name": "init",
              "command": "npm start",
              "icon": "$(play)",
              "description": "the start script"
            },
            {
              "name": "dev",
              "command": "npm run dev",
              "icon": "$(watch)",
              "description": "watch mode (Ctrl+C to stop)"
            },
            {
              "name": "test",
              "command": "npm test",
              "icon": "$(beaker)",
              "description": "tests"
            },
            {
              "name": "typecheck",
              "command": "npx --no-install tsc --noEmit",
              "icon": "$(symbol-interface)",
              "description": "type check with the local TypeScript (warns if not installed)"
            },
            {
              "name": "lint",
              "command": "npm run lint",
              "icon": "$(shield)",
              "description": "eslint"
            },
            {
              "name": "outdated",
              "command": "npm outdated",
              "icon": "$(clock)",
              "description": "outdated"
            },
            {
              "name": "audit fix",
              "command": "npm audit fix",
              "icon": "$(shield)",
              "confirm": "Package versions will change. Continue?",
              "description": "audit fix"
            },
            {
              "name": "clean node_modules",
              "command": "{rm} node_modules",
              "icon": "$(trash)",
              "confirm": "node_modules will be deleted, a reinstall will be needed. Continue?",
              "description": "deletes the dependency folder"
            },
            {
              "name": "link global",
              "command": "npm link",
              "icon": "$(link)",
              "argsPrompt": "package name (e.g. my-lib)",
              "description": "link"
            }
          ]
        },
        {
          "name": "Git",
          "icon": "$(source-control)",
          "color": "#F14E32",
          "commands": [
            {
              "name": "init",
              "command": "git init",
              "icon": "$(new-folder)",
              "description": "make this folder a repository"
            },
            {
              "name": "default branch",
              "command": "git config --global init.defaultBranch",
              "icon": "$(symbol-variable)",
              "argsPrompt": "branch name (e.g. main)",
              "description": "sets the branch name new repositories start on (Git asks about this on every init)",
              "confirm": "This changes the branch name for every new repository on this machine. Continue?"
            },
            {
              "name": "status",
              "command": "git status",
              "icon": "$(source-control)",
              "description": "working tree"
            },
            {
              "name": "diff",
              "command": "git diff",
              "icon": "$(git-compare)",
              "description": "shows the changes"
            },
            {
              "name": "log",
              "command": "git log --oneline --graph -20",
              "icon": "$(history)",
              "description": "last 20 commits"
            },
            {
              "name": "stage all",
              "command": "git add -A",
              "icon": "$(cloud-download)",
              "description": "stages every change"
            },
            {
              "name": "commit",
              "command": "git commit -m",
              "icon": "$(git-commit)",
              "argsPrompt": "commit message",
              "argsSingle": true,
              "description": "commit with a message"
            },
            {
              "name": "push",
              "command": "git push",
              "icon": "$(cloud-upload)",
              "confirm": "Changes will be pushed to the remote. Continue?",
              "description": "push to the remote"
            },
            {
              "name": "remotes",
              "command": "git remote -v",
              "icon": "$(link)",
              "description": "shows the remotes — empty means push has nowhere to go"
            },
            {
              "name": "add remote",
              "command": "git remote add origin",
              "icon": "$(cloud-upload)",
              "argsPrompt": "repository URL (e.g. https://github.com/you/aaa.git)",
              "confirm": "This links this folder to a remote repository. Continue?",
              "description": "links this folder to a remote (create an EMPTY repo on GitHub first)"
            },
            {
              "name": "push first time",
              "command": "git push -u origin",
              "icon": "$(rocket)",
              "argsPrompt": "branch name (e.g. main)",
              "confirm": "This will publish the commits to the remote. Continue?",
              "description": "first push: uploads the history and remembers the branch"
            },
            {
              "name": "pull",
              "command": "git pull",
              "icon": "$(cloud-download)",
              "confirm": "May conflict with local changes. Continue?",
              "description": "fetch from the remote"
            },
            {
              "name": "fetch",
              "command": "git fetch --all --prune",
              "icon": "$(sync)",
              "description": "refresh remotes, drop deleted branches"
            },
            {
              "name": "branches",
              "command": "git branch -a",
              "icon": "$(git-branch)",
              "description": "local and remote branches"
            },
            {
              "name": "switch branch",
              "command": "git checkout",
              "icon": "$(git-branch)",
              "argsPrompt": "branch or file name",
              "description": "switch branch / restore file"
            },
            {
              "name": "new branch",
              "command": "git checkout -b",
              "icon": "$(git-branch)",
              "argsPrompt": "new branch name",
              "description": "create and switch to a branch"
            },
            {
              "name": "stash",
              "command": "git stash",
              "icon": "$(git-stash)",
              "description": "stashes the changes"
            },
            {
              "name": "unstash",
              "command": "git stash pop",
              "icon": "$(git-stash)",
              "description": "restores the stash"
            },
            {
              "name": "undo last commit",
              "command": "git reset --soft HEAD~1",
              "icon": "$(debug-rerun)",
              "confirm": "The last commit will be undone (files are kept). Continue?",
              "description": "soft reset"
            },
            {
              "name": "clone",
              "command": "git clone",
              "icon": "$(repo)",
              "argsPrompt": "repository URL",
              "description": "clone from the remote"
            }
          ]
        },
        {
          "name": "Firebase",
          "icon": "$(broadcast)",
          "color": "#FFCA28",
          "commands": [
            {
              "name": "log in",
              "command": "firebase login",
              "icon": "$(account)",
              "description": "opens a browser session"
            },
            {
              "name": "log out",
              "command": "firebase logout",
              "icon": "$(sign-out)",
              "description": "closes the session"
            },
            {
              "name": "list projects",
              "command": "firebase projects:list",
              "icon": "$(list-ordered)",
              "description": "projects on the account"
            },
            {
              "name": "link project",
              "command": "firebase use",
              "icon": "$(link)",
              "argsPrompt": "project ID",
              "description": "links the folder to a project"
            },
            {
              "name": "deploy hosting",
              "command": "firebase deploy --only hosting",
              "icon": "$(cloud-upload)",
              "confirm": "Hosting will be published to production. Continue?",
              "description": "publishes the static site"
            },
            {
              "name": "deploy functions",
              "command": "firebase deploy --only functions",
              "icon": "$(rocket)",
              "confirm": "Functions will be published to production. Continue?",
              "description": "publishes the server functions"
            },
            {
              "name": "deploy rules",
              "command": "firebase deploy --only firestore:rules",
              "icon": "$(shield)",
              "confirm": "Firestore rules will be published. Continue?",
              "description": "rules + indexes"
            },
            {
              "name": "emulators",
              "command": "firebase emulators:start",
              "icon": "$(beaker)",
              "description": "local emulators (Ctrl+C to stop)"
            },
            {
              "name": "function logs",
              "command": "firebase functions:log",
              "icon": "$(history)",
              "description": "live function logs"
            },
            {
              "name": "init",
              "command": "firebase init",
              "icon": "$(gear)",
              "confirm": "firebase.json will be created or written in this folder. Continue?",
              "description": "configuration (interactive)"
            }
          ]
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "cmdkit-groups.json"
        ],
        "url": "./schemas/cmdkit-groups.json"
      }
    ],
    "configuration": {
      "title": "Cmdkit",
      "properties": {
        "cmdkit.groups": {
          "type": "array",
          "default": [],
          "description": "Command groups shown in the menus. Leave empty to use the built-in defaults (Python, Flutter, Node.js).",
          "items": {
            "type": "object",
            "required": [
              "name",
              "commands"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Grup adı, menüde başlık olarak görünür."
              },
              "icon": {
                "type": "string",
                "default": "$(terminal)",
                "description": "Codicon adı (\"zap\") veya \"$(zap)\" biçiminde yazılabilir. Varsayılan: $(terminal)."
              },
              "color": {
                "type": "string",
                "description": "Durum çubuğundaki bu grup düğmesinin ön plan rengi. \"#4B8BBE\" gibi hex ya da \"charts.blue\" gibi tema rengi adı. Boş bırakılırsa cmdkit.statusBar.color uygulanır."
              },
              "commands": {
                "type": "array",
                "description": "Grup içindeki komutlar.",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "command"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Komutun menüde görünen adı."
                    },
                    "command": {
                      "type": "string",
                      "description": "Çalıştırılacak shell komutu. Platform belirteçleri: {python} (python3 ↔ python), {venv} (.venv/bin/ ↔ .venv\\Scripts\\), {venvpy} (python ↔ python.exe), {rm} (rm -rf ↔ cmd /c rmdir /s /q)."
                    },
                    "description": {
                      "type": "string",
                      "default": "",
                      "description": "Sağda görünen açıklama."
                    },
                    "icon": {
                      "type": "string",
                      "default": "$(terminal)",
                      "description": "Codicon adı (\"play\") veya \"$(play)\" biçiminde yazılabilir. Varsayılan: $(terminal)."
                    },
                    "confirm": {
                      "type": [
                        "string",
                        "boolean"
                      ],
                      "default": false,
                      "description": "true veya bir metin ise çalıştırmadan önce onay ister."
                    },
                    "argsPrompt": {
                      "type": "string",
                      "description": "Çalıştırmadan önce kullanıcıdan argüman sorulur."
                    },
                    "argsSingle": {
                      "type": "boolean",
                      "default": false,
                      "description": "true ise soruda yazdığın değerin tamamı TEK argüman olur, boşluklardan bölünmez. Serbest metin bekleyen bayraklar için gerekir: git commit -m, psql -c, kubectl port-forward."
                    },
                    "clear": {
                      "type": "boolean",
                      "default": false,
                      "description": "true ise terminal temizlenerek çalıştırılır."
                    }
                  }
                }
              }
            }
          }
        },
        "cmdkit.groupFile": {
          "type": "string",
          "default": "",
          "description": "Path to the file where the command list is edited. Relative paths resolve against the first workspace root. Leave empty to use .vscode/cmdkit-groups.json. To point at a sub-package in a monorepo: \"packages/api/cmdkit-groups.json\"."
        },
        "cmdkit.statusBar.icon": {
          "type": "string",
          "default": "terminal",
          "description": "Icon for the status bar button. Accepts a codicon name (\"zap\") or the \"$(zap)\" form. Run \"Cmdkit: Icon Catalog\" to see the candidates."
        },
        "cmdkit.statusBar.color": {
          "type": "string",
          "default": "#4EC9B0",
          "description": "Foreground colour of the status bar buttons. Leave empty to use the theme colour. Either a hex value like \"#4EC9B0\" or a theme colour name such as \"charts.red\" or \"statusBarItem.errorBackground\". Group buttons keep their own colour when they have one."
        },
        "cmdkit.statusBar.background": {
          "type": "string",
          "default": "",
          "description": "Background color of the status bar button. Same format as the foreground color. Leave empty to keep the background transparent."
        },
        "cmdkit.statusBar.showGroups": {
          "type": "boolean",
          "default": true,
          "description": "Show a separate status bar button per group. Clicking one skips the group level and opens that group's commands directly."
        },
        "cmdkit.statusBar.showMaster": {
          "type": "boolean",
          "default": true,
          "description": "Show the \"cmd\" button, which lists every group's commands in a single flat list."
        },
        "cmdkit.statusBar.maxGroupItems": {
          "type": "number",
          "default": 3,
          "description": "Maximum number of group buttons shown in the status bar. Anything beyond that is reachable through the Cmd button and the search command. Set to 0 for no limit. To show no group buttons at all, set cmdkit.statusBar.showGroups to false."
        },
        "cmdkit.statusBar.groupLabel": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "always"
          ],
          "description": "When set to \"always\", the group name is written next to the icon on each group button. Leave empty to show icons only."
        },
        "cmdkit.statusBar.hiddenGroups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Group names not shown in the status bar. For example [\"Python\", \"Node.js\"]."
        },
        "cmdkit.statusBar.priority": {
          "type": "number",
          "default": 250,
          "description": "Order of the status bar buttons. A higher value sits further left; each group button takes 1, 2, 3 below this. Another extension using the same value interleaves with ours — change this value in that case. Values already used on this machine: -1, 0, 1, 100, 1000."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/sync-defaults.mjs && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node esbuild.mjs --tests && node out/test/runTest.js",
    "sync-defaults": "node scripts/sync-defaults.mjs",
    "icon": "node scripts/make-icon.mjs",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hhdblog/cmdkit.git"
  },
  "homepage": "https://github.com/hhdblog/cmdkit#readme",
  "bugs": {
    "url": "https://github.com/hhdblog/cmdkit/issues"
  },
  "galleryBanner": {
    "color": "#1F2430",
    "theme": "dark"
  }
}
