{
  "name": "cmd-deck",
  "displayName": "Cmd Deck",
  "description": "Sık kullanılan terminal komutlarını gruplayan durum çubuğu paneli.",
  "version": "0.1.0",
  "publisher": "cmd-deck",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "keywords": [
    "terminal",
    "commands",
    "status bar",
    "task runner"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cmd-deck.open",
        "title": "Komutlar",
        "category": "Cmd Deck",
        "icon": "$(terminal)"
      },
      {
        "command": "cmd-deck.search",
        "title": "Tüm Komutlarda Ara",
        "category": "Cmd Deck",
        "icon": "$(search)"
      },
      {
        "command": "cmd-deck.runLast",
        "title": "Son Komutu Tekrar Çalıştır",
        "category": "Cmd Deck",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "cmd-deck.reload",
        "title": "Dosyayı Ayarlardan Yenile",
        "category": "Cmd Deck",
        "icon": "$(refresh)"
      },
      {
        "command": "cmd-deck.checkPlatform",
        "title": "Platform Uyumluluğunu Kontrol Et",
        "category": "Cmd Deck",
        "icon": "$(check)"
      },
      {
        "command": "cmd-deck.export",
        "title": "Komut Listesini Düzenle",
        "category": "Cmd Deck",
        "icon": "$(json)"
      },
      {
        "command": "cmd-deck.import",
        "title": "Komut Dosyasını Uygula",
        "category": "Cmd Deck",
        "icon": "$(sync)"
      },
      {
        "command": "cmd-deck.statusBarItems",
        "title": "Durum Çubuğu Düğmelerini Seç",
        "category": "Cmd Deck",
        "icon": "$(list-selection)"
      },
      {
        "command": "cmd-deck.iconCatalog",
        "title": "İkon Kataloğu",
        "category": "Cmd Deck",
        "icon": "$(paintcan)"
      },
      {
        "command": "cmd-deck.addGroup",
        "title": "Hazır Grup Ekle",
        "category": "Cmd Deck",
        "icon": "$(new-folder)"
      },
      {
        "command": "cmd-deck.removeGroup",
        "title": "Grup Kaldır",
        "category": "Cmd Deck",
        "icon": "$(trash)"
      },
      {
        "command": "cmd-deck.usage",
        "title": "Komut Dosyası Nasıl Kullanılır",
        "category": "Cmd Deck",
        "icon": "$(markdown)"
      }
    ],
    "configurationDefaults": {
      "cmdDeck.groups": [
        {
          "name": "Python",
          "icon": "$(snake)",
          "color": "#4B8BBE",
          "commands": [
            {
              "name": "venv oluştur",
              "command": "{python} -m venv .venv",
              "icon": "$(folder)",
              "description": "Sanal ortamı kur"
            },
            {
              "name": "bağımlılıkları kur",
              "command": "{venv}pip install -r requirements.txt",
              "icon": "$(cloud-download)",
              "description": "requirements.txt'ten kur"
            },
            {
              "name": "requirements üret",
              "command": "{venv}pip freeze > requirements.txt",
              "icon": "$(archive)",
              "confirm": "requirements.txt üzerine yazılacak. Devam?",
              "description": "freeze çıktısını dosyaya yaz"
            },
            {
              "name": "paket kur",
              "command": "{venv}pip install",
              "icon": "$(cloud-download)",
              "argsPrompt": "paket adı (örn. requests==2.32.0)",
              "description": "tek paket kur"
            },
            {
              "name": "dosya çalıştır",
              "command": "{venvpy}",
              "icon": "$(play)",
              "argsPrompt": "dosya yolu (örn. main.py)",
              "description": "belirtilen scripti çalıştır"
            },
            {
              "name": "test",
              "command": "{venvpy} -m pytest",
              "icon": "$(beaker)",
              "description": "pytest"
            },
            {
              "name": "format",
              "command": "{venvpy} -m black .",
              "icon": "$(paintcan)",
              "description": "black"
            },
            {
              "name": "lint",
              "command": "{venvpy} -m ruff check .",
              "icon": "$(shield)",
              "description": "ruff"
            },
            {
              "name": "tip kontrolü",
              "command": "{venvpy} -m mypy .",
              "icon": "$(symbol-key)",
              "description": "mypy"
            },
            {
              "name": "Jupyter Lab",
              "command": "{venv}jupyter lab",
              "icon": "$(book)",
              "description": "notebook sunucusu (Ctrl+C ile durur)"
            },
            {
              "name": "bağımlılık listesi",
              "command": "{venv}pip list",
              "icon": "$(list-ordered)",
              "description": "kurulu paketler"
            },
            {
              "name": "güncel olmayanlar",
              "command": "{venv}pip list --outdated",
              "icon": "$(clock)",
              "description": "outdated"
            }
          ]
        },
        {
          "name": "Flutter",
          "icon": "$(device-mobile)",
          "color": "#47C5FB",
          "commands": [
            {
              "name": "pub get",
              "command": "flutter pub get",
              "icon": "$(cloud-download)",
              "description": "bağımlılıkları indir"
            },
            {
              "name": "çalıştır",
              "command": "flutter run",
              "icon": "$(play)",
              "description": "hot reload aktif, Ctrl+C ile durur"
            },
            {
              "name": "build apk",
              "command": "flutter build apk --release",
              "icon": "$(package)",
              "clear": true,
              "description": "APK çıktısı"
            },
            {
              "name": "build web",
              "command": "flutter build web",
              "icon": "$(globe)",
              "clear": true,
              "description": "web çıktısı"
            },
            {
              "name": "build ios",
              "command": "flutter build ios --release",
              "icon": "$(device-desktop)",
              "clear": true,
              "description": "macOS + Xcode gerekir"
            },
            {
              "name": "analyze",
              "command": "flutter analyze",
              "icon": "$(search)",
              "description": "statik analiz"
            },
            {
              "name": "test",
              "command": "flutter test",
              "icon": "$(beaker)",
              "description": "testler"
            },
            {
              "name": "format",
              "command": "dart format .",
              "icon": "$(paintcan)",
              "description": "dart formatter"
            },
            {
              "name": "cihazlar",
              "command": "flutter devices",
              "icon": "$(device-mobile)",
              "description": "bağlı cihazlar"
            },
            {
              "name": "temizle",
              "command": "flutter clean",
              "icon": "$(discard)",
              "confirm": "Derleme önbelleği silinecek. Devam?",
              "description": "build klasörlerini siler"
            },
            {
              "name": "upgrade",
              "command": "flutter upgrade",
              "icon": "$(cloud-upload)",
              "description": "SDK güncelle"
            },
            {
              "name": "stable kanal",
              "command": "flutter channel stable && flutter upgrade",
              "icon": "$(sync)",
              "description": "kanala geç ve güncelle"
            }
          ]
        },
        {
          "name": "Node.js",
          "icon": "$(server-environment)",
          "color": "#83CD29",
          "commands": [
            {
              "name": "kur",
              "command": "npm install",
              "icon": "$(cloud-download)",
              "description": "bağımlılıkları kur"
            },
            {
              "name": "temiz kur",
              "command": "npm ci",
              "icon": "$(cloud-download)",
              "clear": true,
              "description": "lock dosyasından birebir kur"
            },
            {
              "name": "derle",
              "command": "npm run build",
              "icon": "$(tools)",
              "clear": true,
              "description": "production build"
            },
            {
              "name": "başlat",
              "command": "npm start",
              "icon": "$(play)",
              "description": "start scripti"
            },
            {
              "name": "dev",
              "command": "npm run dev",
              "icon": "$(watch)",
              "description": "watch modu (Ctrl+C ile durur)"
            },
            {
              "name": "test",
              "command": "npm test",
              "icon": "$(beaker)",
              "description": "testler"
            },
            {
              "name": "typecheck",
              "command": "npx --no-install tsc --noEmit",
              "icon": "$(symbol-interface)",
              "description": "yerel TypeScript ile tip kontrolü (kurulu değilse uyarır)"
            },
            {
              "name": "lint",
              "command": "npm run lint",
              "icon": "$(shield)",
              "description": "eslint"
            },
            {
              "name": "outdated",
              "command": "npm outdated",
              "icon": "$(clock)",
              "description": "güncel olmayanlar"
            },
            {
              "name": "güvenlik açığı düzelt",
              "command": "npm audit fix",
              "icon": "$(shield)",
              "confirm": "paket sürümleri değişecek. Devam?",
              "description": "audit fix"
            },
            {
              "name": "node_modules temizle",
              "command": "{rm} node_modules",
              "icon": "$(trash)",
              "confirm": "node_modules silinecek, yeniden kurulum gerekir. Devam?",
              "description": "bağımlılık klasörünü sil"
            },
            {
              "name": "global bağla",
              "command": "npm link",
              "icon": "$(link)",
              "argsPrompt": "paket adı (örn. my-lib)",
              "description": "link"
            }
          ]
        },
        {
          "name": "Git",
          "icon": "$(source-control)",
          "color": "#F14E32",
          "commands": [
            {
              "name": "durum",
              "command": "git status",
              "icon": "$(source-control)",
              "description": "çalışma ağacı"
            },
            {
              "name": "fark",
              "command": "git diff",
              "icon": "$(git-compare)",
              "description": "değişiklikleri göster"
            },
            {
              "name": "log",
              "command": "git log --oneline --graph -20",
              "icon": "$(history)",
              "description": "son 20 commit"
            },
            {
              "name": "hepsini ekle",
              "command": "git add -A",
              "icon": "$(cloud-download)",
              "description": "tüm değişiklikleri sahneye al"
            },
            {
              "name": "commit",
              "command": "git commit -m",
              "icon": "$(git-commit)",
              "argsPrompt": "commit mesajı",
              "argsSingle": true,
              "description": "mesajla commit"
            },
            {
              "name": "push",
              "command": "git push",
              "icon": "$(cloud-upload)",
              "confirm": "Değişiklikler uzak depoya gönderilecek. Devam?",
              "description": "uzak depoya gönder"
            },
            {
              "name": "pull",
              "command": "git pull",
              "icon": "$(cloud-download)",
              "confirm": "Yerel değişikliklerle çakışabilir. Devam?",
              "description": "uzaktan çek"
            },
            {
              "name": "fetch",
              "command": "git fetch --all --prune",
              "icon": "$(sync)",
              "description": "uzakları tazele, silinen dalları at"
            },
            {
              "name": "dallar",
              "command": "git branch -a",
              "icon": "$(git-branch)",
              "description": "yerel ve uzak dallar"
            },
            {
              "name": "dala geç",
              "command": "git checkout",
              "icon": "$(git-branch)",
              "argsPrompt": "dal veya dosya adı",
              "description": "dal değiştir / dosyayı geri al"
            },
            {
              "name": "yeni dal",
              "command": "git checkout -b",
              "icon": "$(git-branch)",
              "argsPrompt": "yeni dal adı",
              "description": "dal oluştur ve geç"
            },
            {
              "name": "stash",
              "command": "git stash",
              "icon": "$(git-stash)",
              "description": "değişiklikleri sakla"
            },
            {
              "name": "stash geri al",
              "command": "git stash pop",
              "icon": "$(git-stash)",
              "description": "saklananı geri yükle"
            },
            {
              "name": "son commit'i geri al",
              "command": "git reset --soft HEAD~1",
              "icon": "$(debug-rerun)",
              "confirm": "Son commit geri alınacak (dosyalar korunur). Devam?",
              "description": "soft reset"
            },
            {
              "name": "klonla",
              "command": "git clone",
              "icon": "$(repo)",
              "argsPrompt": "depo adresi",
              "description": "uzaktan klonla"
            }
          ]
        },
        {
          "name": "Firebase",
          "icon": "$(broadcast)",
          "color": "#FFCA28",
          "commands": [
            {
              "name": "giriş yap",
              "command": "firebase login",
              "icon": "$(account)",
              "description": "tarayıcıda oturum açar"
            },
            {
              "name": "çıkış yap",
              "command": "firebase logout",
              "icon": "$(sign-out)",
              "description": "oturumu kapat"
            },
            {
              "name": "projeleri listele",
              "command": "firebase projects:list",
              "icon": "$(list-ordered)",
              "description": "hesabındaki projeler"
            },
            {
              "name": "projeye bağlan",
              "command": "firebase use",
              "icon": "$(link)",
              "argsPrompt": "proje adı",
              "description": "klasörü projeye bağlar"
            },
            {
              "name": "hosting deploy",
              "command": "firebase deploy --only hosting",
              "icon": "$(cloud-upload)",
              "confirm": "Hosting canlıya yayınlanacak. Devam?",
              "description": "statik siteyi yayınla"
            },
            {
              "name": "functions deploy",
              "command": "firebase deploy --only functions",
              "icon": "$(rocket)",
              "confirm": "Functions canlıya yayınlanacak. Devam?",
              "description": "sunucu fonksiyonlarını yayınla"
            },
            {
              "name": "kuralları deploy",
              "command": "firebase deploy --only firestore:rules",
              "icon": "$(shield)",
              "confirm": "Firestore kuralları yayınlanacak. Devam?",
              "description": "rules + indexes"
            },
            {
              "name": "emülatörler",
              "command": "firebase emulators:start",
              "icon": "$(beaker)",
              "description": "yerel emülatörler (Ctrl+C ile durur)"
            },
            {
              "name": "fonksiyon logları",
              "command": "firebase functions:log",
              "icon": "$(history)",
              "description": "canlı fonksiyon logları"
            },
            {
              "name": "başlat",
              "command": "firebase init",
              "icon": "$(gear)",
              "confirm": "Klasörde firebase.json oluşturulacak/yazılacak. Devam?",
              "description": "yapılandırma (interaktif)"
            }
          ]
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "cmd-deck-groups.json"
        ],
        "url": "./schemas/cmd-deck-groups.json"
      }
    ],
    "configuration": {
      "title": "Cmd Deck",
      "properties": {
        "cmdDeck.groups": {
          "type": "array",
          "default": [],
          "description": "Durum çubuğu menüsünde gösterilecek komut grupları. Boş bırakılırsa eklentinin varsayılan grupları (Python, Flutter, Node.js) kullanılır.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "commands"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Grup adı, menüde başlık olarak görünür."
              },
              "icon": {
                "type": "string",
                "default": "$(terminal)",
                "description": "Codicon adı (\"zap\") veya \"$(zap)\" biçiminde yazılabilir. Varsayılan: $(terminal)."
              },
              "color": {
                "type": "string",
                "description": "Durum çubuğundaki bu grup düğmesinin ön plan rengi. \"#4B8BBE\" gibi hex ya da \"charts.blue\" gibi tema rengi adı. Boş bırakılırsa cmdDeck.statusBar.color uygulanır."
              },
              "commands": {
                "type": "array",
                "description": "Grup içindeki komutlar.",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "command"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Komutun menüde görünen adı."
                    },
                    "command": {
                      "type": "string",
                      "description": "Çalıştırılacak shell komutu. Platform belirteçleri: {python} (python3 ↔ python), {venv} (.venv/bin/ ↔ .venv\\Scripts\\), {venvpy} (python ↔ python.exe), {rm} (rm -rf ↔ cmd /c rmdir /s /q)."
                    },
                    "description": {
                      "type": "string",
                      "default": "",
                      "description": "Sağda görünen açıklama."
                    },
                    "icon": {
                      "type": "string",
                      "default": "$(terminal)",
                      "description": "Codicon adı (\"play\") veya \"$(play)\" biçiminde yazılabilir. Varsayılan: $(terminal)."
                    },
                    "confirm": {
                      "type": [
                        "string",
                        "boolean"
                      ],
                      "default": false,
                      "description": "true veya bir metin ise çalıştırmadan önce onay ister."
                    },
                    "argsPrompt": {
                      "type": "string",
                      "description": "Çalıştırmadan önce kullanıcıdan argüman sorulur."
                    },
                    "argsSingle": {
                      "type": "boolean",
                      "default": false,
                      "description": "true ise soruda yazdığın değerin tamamı TEK argüman olur, boşluklardan bölünmez. Serbest metin bekleyen bayraklar için gerekir: git commit -m, psql -c, kubectl port-forward."
                    },
                    "clear": {
                      "type": "boolean",
                      "default": false,
                      "description": "true ise terminal temizlenerek çalıştırılır."
                    }
                  }
                }
              }
            }
          }
        },
        "cmdDeck.groupFile": {
          "type": "string",
          "default": "",
          "description": "Komut listesinin düzenlendiği dosyanın yolu. Göreli yollar ilk çalışma alanı köküne göre çözülür. Boş bırakılırsa .vscode/cmd-deck-groups.json kullanılır. Monorepo'da alt paketi göstermek için: \"packages/api/cmd-deck-groups.json\"."
        },
        "cmdDeck.statusBar.icon": {
          "type": "string",
          "default": "terminal",
          "description": "Durum çubuğu düğmesinin ikonu. Kodikon adı (\"zap\") veya \"$(zap)\" biçiminde yazılabilir. Adaylar: \"Cmd Deck: İkon Kataloğu\"."
        },
        "cmdDeck.statusBar.color": {
          "type": "string",
          "default": "",
          "description": "Durum çubuğu düğmesinin ön plan rengi. Boş bırakılırsa tema rengi kullanılır. \"#4EC9B0\" gibi hex ya da \"charts.red\", \"statusBarItem.errorBackground\" gibi tema rengi adı."
        },
        "cmdDeck.statusBar.background": {
          "type": "string",
          "default": "",
          "description": "Durum çubuğu düğmesinin arka plan rengi. Aynı biçim: hex veya tema rengi adı. Boş bırakılırsa arka plan şeffaf kalır."
        },
        "cmdDeck.statusBar.showGroups": {
          "type": "boolean",
          "default": true,
          "description": "Her grup için durum çubuğunda ayrı bir düğme gösterir. Tıklanınca grup seviyesi atlanır ve o grubun komutları açılır."
        },
        "cmdDeck.statusBar.showMaster": {
          "type": "boolean",
          "default": true,
          "description": "\"cmd\" düğmesini gösterir: tüm gruplar tek listeden seçilir."
        },
        "cmdDeck.statusBar.maxGroupItems": {
          "type": "number",
          "default": 3,
          "description": "Durum çubuğunda en fazla kaç grup düğmesi gösterilsin. Fazlası yalnızca Cmd düğmesi ve arama üzerinden erişilebilir. 0 yazarsan sınırsız olur, tüm gruplar gösterilir. Hiç grup düğmesi istemiyorsan cmdDeck.statusBar.showGroups = false."
        },
        "cmdDeck.statusBar.groupLabel": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "always"
          ],
          "description": "\"always\" ise grup düğmelerinde ikonun yanına grup adı da yazılır. Boş bırakılırsa yalnızca ikon görünür."
        },
        "cmdDeck.statusBar.hiddenGroups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Durum çubuğunda gösterilmeyecek grup adları. Örn. [\"Python\", \"Node.js\"]."
        },
        "cmdDeck.statusBar.priority": {
          "type": "number",
          "default": 250,
          "description": "Durum çubuğu düğmelerinin sırası. Yüksek değer daha sola gelir; grup düğmeleri bundan 1, 2, 3 azalır. Başka bir eklenti aynı değeri kullanırsa düğmelerimizin arasına girer, o durumda bu değeri değiştir. Bu makinede kullanılan değerler: -1, 0, 1, 100, 1000."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/sync-defaults.mjs && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node esbuild.mjs --tests && node out/test/runTest.js",
    "sync-defaults": "node scripts/sync-defaults.mjs",
    "icon": "node scripts/make-icon.mjs",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
