{
  "defaults": [
    "Python",
    "Flutter",
    "Node.js",
    "Git",
    "Firebase"
  ],
  "groups": [
    {
      "name": "Python",
      "summary": "venv, test, format, lint",
      "icon": "$(snake)",
      "color": "#4B8BBE",
      "commands": [
        {
          "name": "venv oluştur",
          "command": "{python} -m venv .venv",
          "icon": "$(folder)",
          "description": "Sanal ortamı kur"
        },
        {
          "name": "bağımlılıkları kur",
          "command": "{venv}pip install -r requirements.txt",
          "icon": "$(cloud-download)",
          "description": "requirements.txt'ten kur"
        },
        {
          "name": "requirements üret",
          "command": "{venv}pip freeze > requirements.txt",
          "icon": "$(archive)",
          "confirm": "requirements.txt üzerine yazılacak. Devam?",
          "description": "freeze çıktısını dosyaya yaz"
        },
        {
          "name": "paket kur",
          "command": "{venv}pip install",
          "icon": "$(cloud-download)",
          "argsPrompt": "paket adı (örn. requests==2.32.0)",
          "description": "tek paket kur"
        },
        {
          "name": "dosya çalıştır",
          "command": "{venvpy}",
          "icon": "$(play)",
          "argsPrompt": "dosya yolu (örn. main.py)",
          "description": "belirtilen scripti çalıştır"
        },
        {
          "name": "test",
          "command": "{venvpy} -m pytest",
          "icon": "$(beaker)",
          "description": "pytest"
        },
        {
          "name": "format",
          "command": "{venvpy} -m black .",
          "icon": "$(paintcan)",
          "description": "black"
        },
        {
          "name": "lint",
          "command": "{venvpy} -m ruff check .",
          "icon": "$(shield)",
          "description": "ruff"
        },
        {
          "name": "tip kontrolü",
          "command": "{venvpy} -m mypy .",
          "icon": "$(symbol-key)",
          "description": "mypy"
        },
        {
          "name": "Jupyter Lab",
          "command": "{venv}jupyter lab",
          "icon": "$(book)",
          "description": "notebook sunucusu (Ctrl+C ile durur)"
        },
        {
          "name": "bağımlılık listesi",
          "command": "{venv}pip list",
          "icon": "$(list-ordered)",
          "description": "kurulu paketler"
        },
        {
          "name": "güncel olmayanlar",
          "command": "{venv}pip list --outdated",
          "icon": "$(clock)",
          "description": "outdated"
        }
      ]
    },
    {
      "name": "Flutter",
      "summary": "pub get, build, analyze",
      "icon": "$(device-mobile)",
      "color": "#47C5FB",
      "commands": [
        {
          "name": "pub get",
          "command": "flutter pub get",
          "icon": "$(cloud-download)",
          "description": "bağımlılıkları indir"
        },
        {
          "name": "çalıştır",
          "command": "flutter run",
          "icon": "$(play)",
          "description": "hot reload aktif, Ctrl+C ile durur"
        },
        {
          "name": "build apk",
          "command": "flutter build apk --release",
          "icon": "$(package)",
          "clear": true,
          "description": "APK çıktısı"
        },
        {
          "name": "build web",
          "command": "flutter build web",
          "icon": "$(globe)",
          "clear": true,
          "description": "web çıktısı"
        },
        {
          "name": "build ios",
          "command": "flutter build ios --release",
          "icon": "$(device-desktop)",
          "clear": true,
          "description": "macOS + Xcode gerekir"
        },
        {
          "name": "analyze",
          "command": "flutter analyze",
          "icon": "$(search)",
          "description": "statik analiz"
        },
        {
          "name": "test",
          "command": "flutter test",
          "icon": "$(beaker)",
          "description": "testler"
        },
        {
          "name": "format",
          "command": "dart format .",
          "icon": "$(paintcan)",
          "description": "dart formatter"
        },
        {
          "name": "cihazlar",
          "command": "flutter devices",
          "icon": "$(device-mobile)",
          "description": "bağlı cihazlar"
        },
        {
          "name": "temizle",
          "command": "flutter clean",
          "icon": "$(discard)",
          "confirm": "Derleme önbelleği silinecek. Devam?",
          "description": "build klasörlerini siler"
        },
        {
          "name": "upgrade",
          "command": "flutter upgrade",
          "icon": "$(cloud-upload)",
          "description": "SDK güncelle"
        },
        {
          "name": "stable kanal",
          "command": "flutter channel stable && flutter upgrade",
          "icon": "$(sync)",
          "description": "kanala geç ve güncelle"
        }
      ]
    },
    {
      "name": "Node.js",
      "summary": "kur, build, test, lint",
      "icon": "$(server-environment)",
      "color": "#83CD29",
      "commands": [
        {
          "name": "kur",
          "command": "npm install",
          "icon": "$(cloud-download)",
          "description": "bağımlılıkları kur"
        },
        {
          "name": "temiz kur",
          "command": "npm ci",
          "icon": "$(cloud-download)",
          "clear": true,
          "description": "lock dosyasından birebir kur"
        },
        {
          "name": "derle",
          "command": "npm run build",
          "icon": "$(tools)",
          "clear": true,
          "description": "production build"
        },
        {
          "name": "başlat",
          "command": "npm start",
          "icon": "$(play)",
          "description": "start scripti"
        },
        {
          "name": "dev",
          "command": "npm run dev",
          "icon": "$(watch)",
          "description": "watch modu (Ctrl+C ile durur)"
        },
        {
          "name": "test",
          "command": "npm test",
          "icon": "$(beaker)",
          "description": "testler"
        },
        {
          "name": "typecheck",
          "command": "npx --no-install tsc --noEmit",
          "icon": "$(symbol-interface)",
          "description": "yerel TypeScript ile tip kontrolü (kurulu değilse uyarır)"
        },
        {
          "name": "lint",
          "command": "npm run lint",
          "icon": "$(shield)",
          "description": "eslint"
        },
        {
          "name": "outdated",
          "command": "npm outdated",
          "icon": "$(clock)",
          "description": "güncel olmayanlar"
        },
        {
          "name": "güvenlik açığı düzelt",
          "command": "npm audit fix",
          "icon": "$(shield)",
          "confirm": "paket sürümleri değişecek. Devam?",
          "description": "audit fix"
        },
        {
          "name": "node_modules temizle",
          "command": "{rm} node_modules",
          "icon": "$(trash)",
          "confirm": "node_modules silinecek, yeniden kurulum gerekir. Devam?",
          "description": "bağımlılık klasörünü sil"
        },
        {
          "name": "global bağla",
          "command": "npm link",
          "icon": "$(link)",
          "argsPrompt": "paket adı (örn. my-lib)",
          "description": "link"
        }
      ]
    },
    {
      "name": "Git",
      "summary": "durum, dallar, commit, push",
      "icon": "$(source-control)",
      "color": "#F14E32",
      "commands": [
        {
          "name": "durum",
          "command": "git status",
          "icon": "$(source-control)",
          "description": "çalışma ağacı"
        },
        {
          "name": "fark",
          "command": "git diff",
          "icon": "$(git-compare)",
          "description": "değişiklikleri göster"
        },
        {
          "name": "log",
          "command": "git log --oneline --graph -20",
          "icon": "$(history)",
          "description": "son 20 commit"
        },
        {
          "name": "hepsini ekle",
          "command": "git add -A",
          "icon": "$(cloud-download)",
          "description": "tüm değişiklikleri sahneye al"
        },
        {
          "name": "commit",
          "command": "git commit -m",
          "icon": "$(git-commit)",
          "argsPrompt": "commit mesajı",
          "argsSingle": true,
          "description": "mesajla commit"
        },
        {
          "name": "push",
          "command": "git push",
          "icon": "$(cloud-upload)",
          "confirm": "Değişiklikler uzak depoya gönderilecek. Devam?",
          "description": "uzak depoya gönder"
        },
        {
          "name": "pull",
          "command": "git pull",
          "icon": "$(cloud-download)",
          "confirm": "Yerel değişikliklerle çakışabilir. Devam?",
          "description": "uzaktan çek"
        },
        {
          "name": "fetch",
          "command": "git fetch --all --prune",
          "icon": "$(sync)",
          "description": "uzakları tazele, silinen dalları at"
        },
        {
          "name": "dallar",
          "command": "git branch -a",
          "icon": "$(git-branch)",
          "description": "yerel ve uzak dallar"
        },
        {
          "name": "dala geç",
          "command": "git checkout",
          "icon": "$(git-branch)",
          "argsPrompt": "dal veya dosya adı",
          "description": "dal değiştir / dosyayı geri al"
        },
        {
          "name": "yeni dal",
          "command": "git checkout -b",
          "icon": "$(git-branch)",
          "argsPrompt": "yeni dal adı",
          "description": "dal oluştur ve geç"
        },
        {
          "name": "stash",
          "command": "git stash",
          "icon": "$(git-stash)",
          "description": "değişiklikleri sakla"
        },
        {
          "name": "stash geri al",
          "command": "git stash pop",
          "icon": "$(git-stash)",
          "description": "saklananı geri yükle"
        },
        {
          "name": "son commit'i geri al",
          "command": "git reset --soft HEAD~1",
          "icon": "$(debug-rerun)",
          "confirm": "Son commit geri alınacak (dosyalar korunur). Devam?",
          "description": "soft reset"
        },
        {
          "name": "klonla",
          "command": "git clone",
          "icon": "$(repo)",
          "argsPrompt": "depo adresi",
          "description": "uzaktan klonla"
        }
      ]
    },
    {
      "name": "Firebase",
      "summary": "login, deploy, emülatörler",
      "icon": "$(broadcast)",
      "color": "#FFCA28",
      "commands": [
        {
          "name": "giriş yap",
          "command": "firebase login",
          "icon": "$(account)",
          "description": "tarayıcıda oturum açar"
        },
        {
          "name": "çıkış yap",
          "command": "firebase logout",
          "icon": "$(sign-out)",
          "description": "oturumu kapat"
        },
        {
          "name": "projeleri listele",
          "command": "firebase projects:list",
          "icon": "$(list-ordered)",
          "description": "hesabındaki projeler"
        },
        {
          "name": "projeye bağlan",
          "command": "firebase use --add",
          "icon": "$(link)",
          "argsPrompt": "proje adı",
          "description": "klasörü projeye bağlar"
        },
        {
          "name": "hosting deploy",
          "command": "firebase deploy --only hosting",
          "icon": "$(cloud-upload)",
          "confirm": "Hosting canlıya yayınlanacak. Devam?",
          "description": "statik siteyi yayınla"
        },
        {
          "name": "functions deploy",
          "command": "firebase deploy --only functions",
          "icon": "$(rocket)",
          "confirm": "Functions canlıya yayınlanacak. Devam?",
          "description": "sunucu fonksiyonlarını yayınla"
        },
        {
          "name": "kuralları deploy",
          "command": "firebase deploy --only firestore:rules",
          "icon": "$(shield)",
          "confirm": "Firestore kuralları yayınlanacak. Devam?",
          "description": "rules + indexes"
        },
        {
          "name": "emülatörler",
          "command": "firebase emulators:start",
          "icon": "$(beaker)",
          "description": "yerel emülatörler (Ctrl+C ile durur)"
        },
        {
          "name": "fonksiyon logları",
          "command": "firebase functions:log",
          "icon": "$(history)",
          "description": "canlı fonksiyon logları"
        },
        {
          "name": "başlat",
          "command": "firebase init",
          "icon": "$(gear)",
          "confirm": "Klasörde firebase.json oluşturulacak/yazılacak. Devam?",
          "description": "yapılandırma (interaktif)"
        }
      ]
    },
    {
      "name": "Docker",
      "icon": "$(package)",
      "color": "#2496ED",
      "summary": "derle, başlat, logla, temizle",
      "commands": [
        {
          "name": "derle",
          "command": "docker compose build",
          "icon": "$(package)",
          "description": "imajları derler"
        },
        {
          "name": "başlat",
          "command": "docker compose up -d",
          "icon": "$(play)",
          "description": "arka planda başlatır"
        },
        {
          "name": "durdur",
          "command": "docker compose down",
          "icon": "$(discard)",
          "description": "kapları indirir"
        },
        {
          "name": "loglar",
          "command": "docker compose logs -f",
          "icon": "$(output)",
          "description": "logları canlı izle (Ctrl+C ile durur)"
        },
        {
          "name": "çalışanlar",
          "command": "docker ps",
          "icon": "$(server)",
          "description": "çalışan kaplar"
        },
        {
          "name": "kabuğa gir",
          "command": "docker compose exec",
          "icon": "$(terminal)",
          "argsPrompt": "servis adı (örn. api)",
          "description": "servisin içine shell"
        },
        {
          "name": "imajlar",
          "command": "docker images",
          "icon": "$(files)",
          "description": "yerel imajlar"
        },
        {
          "name": "temizle",
          "command": "docker compose down -v --remove-orphans",
          "icon": "$(trash)",
          "confirm": "Sistemdeki kaplar, hacimler ve ağlar silinecek. Devam?",
          "description": "kapları ve hacimleri siler"
        },
        {
          "name": "sistemi temizle",
          "command": "docker system prune -a",
          "icon": "$(warning)",
          "confirm": "Kullanılmayan tüm imajlar, kaplar ve ağlar silinecek. Bu geri alınamaz. Devam?",
          "description": "tüm kullanılmayan kaynakları siler"
        }
      ]
    },
    {
      "name": "GitHub CLI",
      "icon": "$(source-control)",
      "color": "#8B949E",
      "summary": "PR, issue ve çalışmalar",
      "commands": [
        {
          "name": "durum",
          "command": "gh status",
          "icon": "$(source-control)",
          "description": "PR ve issue özeti"
        },
        {
          "name": "PR listele",
          "command": "gh pr list",
          "icon": "$(git-pull-request)",
          "description": "açık PR'lar"
        },
        {
          "name": "PR aç",
          "command": "gh pr create",
          "icon": "$(git-pull-request)",
          "description": "yeni PR oluşturur"
        },
        {
          "name": "PR görüntüle",
          "command": "gh pr view",
          "icon": "$(git-compare)",
          "description": "mevcut PR'ı açar"
        },
        {
          "name": "PR indir",
          "command": "gh pr checkout",
          "icon": "$(cloud-download)",
          "argsPrompt": "dal veya PR numarası",
          "description": "PR'ın dalına geç"
        },
        {
          "name": "issue aç",
          "command": "gh issue create",
          "icon": "$(edit)",
          "description": "yeni issue"
        },
        {
          "name": "issue listele",
          "command": "gh issue list",
          "icon": "$(list-ordered)",
          "description": "açık issue'lar"
        },
        {
          "name": "depoyu görüntüle",
          "command": "gh repo view",
          "icon": "$(repo)",
          "description": "depo bilgisi"
        },
        {
          "name": "çalışmalar",
          "command": "gh run list",
          "icon": "$(history)",
          "description": "Actions çalışmaları"
        },
        {
          "name": "çalışma izle",
          "command": "gh run watch",
          "icon": "$(watch)",
          "argsPrompt": "çalışma numarası",
          "description": "çalışmayı canlı izle"
        },
        {
          "name": "sürüm oluştur",
          "command": "gh release create",
          "icon": "$(tag)",
          "argsPrompt": "sürüm etiketi (örn. v1.0.0)",
          "confirm": "Sürüm yayınlanacak. Devam?",
          "description": "yeni sürüm oluşturur"
        },
        {
          "name": "oturum",
          "command": "gh auth status",
          "icon": "$(account)",
          "description": "giriş durumu"
        }
      ]
    },
    {
      "name": "PostgreSQL",
      "icon": "$(database)",
      "color": "#4169E1",
      "summary": "bağlan, sorgula, yedekle",
      "commands": [
        {
          "name": "bağlan",
          "command": "psql -U postgres",
          "icon": "$(terminal)",
          "description": "psql kabuğu (Ctrl+C ile çık)"
        },
        {
          "name": "veritabanları",
          "command": "psql -l",
          "icon": "$(list-ordered)",
          "description": "veritabanlarını listeler"
        },
        {
          "name": "sorgu çalıştır",
          "command": "psql -c",
          "icon": "$(search)",
          "argsPrompt": "SQL (örn. SELECT * FROM users LIMIT 10)",
          "argsSingle": true,
          "description": "tek sorgu çalıştırıp çıkar"
        },
        {
          "name": "yedek al",
          "command": "pg_dump",
          "icon": "$(archive)",
          "argsPrompt": "veritabanı adı",
          "description": "SQL dökümü alır"
        },
        {
          "name": "geri yükle",
          "command": "psql -f",
          "icon": "$(cloud-upload)",
          "argsPrompt": "SQL dosyası",
          "description": "SQL dosyasını çalıştırır"
        },
        {
          "name": "tablo boyutları",
          "command": "psql -c \"dt+\"",
          "icon": "$(table)",
          "description": "tablolar ve boyutları"
        },
        {
          "name": "kilitleri izle",
          "command": "psql -c \"SELECT * FROM pg_stat_activity\"",
          "icon": "$(clock)",
          "description": "açık sorgular ve kilitler"
        }
      ]
    },
    {
      "name": "Go",
      "icon": "$(server-environment)",
      "color": "#00ADD8",
      "summary": "test, derle, mod düzenle",
      "commands": [
        {
          "name": "test",
          "command": "go test ./...",
          "icon": "$(beaker)",
          "description": "tüm testler"
        },
        {
          "name": "derle",
          "command": "go build ./...",
          "icon": "$(package)",
          "description": "derler"
        },
        {
          "name": "çalıştır",
          "command": "go run",
          "icon": "$(play)",
          "argsPrompt": "dosya yolu (örn. ./cmd/api)",
          "description": "çalıştırır (Ctrl+C ile durur)"
        },
        {
          "name": "mod tidy",
          "command": "go mod tidy",
          "icon": "$(sync)",
          "description": "bağımlılıkları düzenler"
        },
        {
          "name": "vet",
          "command": "go vet ./...",
