{
  "defaults": [
    "Python",
    "Flutter",
    "Node.js",
    "Git",
    "Firebase"
  ],
  "groups": [
    {
      "name": "Python",
      "summary": "venv, test, format, lint",
      "icon": "$(snake)",
      "color": "#4B8BBE",
      "commands": [
        {
          "name": "create venv",
          "command": "{python} -m venv .venv",
          "icon": "$(folder)",
          "description": "creates a virtual environment"
        },
        {
          "name": "install dependencies",
          "command": "{venv}pip install -r requirements.txt",
          "icon": "$(cloud-download)",
          "description": "install from requirements.txt"
        },
        {
          "name": "freeze to requirements.txt",
          "command": "{venv}pip freeze > requirements.txt",
          "icon": "$(archive)",
          "confirm": "requirements.txt will be overwritten. Continue?",
          "description": "writes the freeze output to a file"
        },
        {
          "name": "install package",
          "command": "{venv}pip install",
          "icon": "$(cloud-download)",
          "argsPrompt": "package name (e.g. requests==2.32.0)",
          "description": "installs a single package"
        },
        {
          "name": "run file",
          "command": "{venvpy}",
          "icon": "$(play)",
          "argsPrompt": "file path (e.g. main.py)",
          "description": "runs the given script"
        },
        {
          "name": "test",
          "command": "{venvpy} -m pytest",
          "icon": "$(beaker)",
          "description": "pytest"
        },
        {
          "name": "format",
          "command": "{venvpy} -m black .",
          "icon": "$(paintcan)",
          "description": "black"
        },
        {
          "name": "lint",
          "command": "{venvpy} -m ruff check .",
          "icon": "$(shield)",
          "description": "ruff"
        },
        {
          "name": "type check",
          "command": "{venvpy} -m mypy .",
          "icon": "$(symbol-key)",
          "description": "mypy"
        },
        {
          "name": "Jupyter Lab",
          "command": "{venv}jupyter lab",
          "icon": "$(book)",
          "description": "notebook server (Ctrl+C to stop)"
        },
        {
          "name": "list dependencies",
          "command": "{venv}pip list",
          "icon": "$(list-ordered)",
          "description": "installed packages"
        },
        {
          "name": "outdated",
          "command": "{venv}pip list --outdated",
          "icon": "$(clock)",
          "description": "outdated"
        }
      ]
    },
    {
      "name": "Flutter",
      "summary": "pub get, build, analyze",
      "icon": "$(device-mobile)",
      "color": "#47C5FB",
      "commands": [
        {
          "name": "pub get",
          "command": "flutter pub get",
          "icon": "$(cloud-download)",
          "description": "download dependencies"
        },
        {
          "name": "run",
          "command": "flutter run",
          "icon": "$(play)",
          "description": "hot reload is on, Ctrl+C to stop"
        },
        {
          "name": "build apk",
          "command": "flutter build apk --release",
          "icon": "$(package)",
          "clear": true,
          "description": "APK output"
        },
        {
          "name": "build web",
          "command": "flutter build web",
          "icon": "$(globe)",
          "clear": true,
          "description": "web output"
        },
        {
          "name": "build ios",
          "command": "flutter build ios --release",
          "icon": "$(device-desktop)",
          "clear": true,
          "description": "requires macOS + Xcode"
        },
        {
          "name": "analyze",
          "command": "flutter analyze",
          "icon": "$(search)",
          "description": "static analysis"
        },
        {
          "name": "doctor",
          "command": "flutter doctor",
          "icon": "$(beaker)",
          "description": "checks the Flutter/Android/Xcode setup"
        },
        {
          "name": "doctor verbose",
          "command": "flutter doctor -v",
          "icon": "$(list-ordered)",
          "description": "the same check with full detail"
        },
        {
          "name": "test",
          "command": "flutter test",
          "icon": "$(beaker)",
          "description": "tests"
        },
        {
          "name": "format",
          "command": "dart format .",
          "icon": "$(paintcan)",
          "description": "dart formatter"
        },
        {
          "name": "devices",
          "command": "flutter devices",
          "icon": "$(device-mobile)",
          "description": "connected devices"
        },
        {
          "name": "clean",
          "command": "flutter clean",
          "icon": "$(discard)",
          "confirm": "The build cache will be deleted. Continue?",
          "description": "deletes the build directories"
        },
        {
          "name": "upgrade",
          "command": "flutter upgrade",
          "icon": "$(cloud-upload)",
          "description": "updates the SDK"
        },
        {
          "name": "upgrade force",
          "command": "flutter upgrade --force",
          "icon": "$(cloud-download)",
          "confirm": "Local changes in your Flutter checkout will be ERASED. This cannot be undone. Continue?",
          "description": "upgrade even with local changes — throws them away"
        },
        {
          "name": "stable channel",
          "command": "flutter channel stable && flutter upgrade",
          "icon": "$(sync)",
          "description": "switch to the channel and update"
        }
      ]
    },
    {
      "name": "Node.js",
      "summary": "install, build, test, lint",
      "icon": "$(server-environment)",
      "color": "#83CD29",
      "commands": [
        {
          "name": "install",
          "command": "npm install",
          "icon": "$(cloud-download)",
          "description": "install dependencies"
        },
        {
          "name": "clean install",
          "command": "npm ci",
          "icon": "$(cloud-download)",
          "clear": true,
          "description": "installs exactly from the lock file"
        },
        {
          "name": "build",
          "command": "npm run build",
          "icon": "$(tools)",
          "clear": true,
          "description": "production build"
        },
        {
          "name": "init",
          "command": "npm start",
          "icon": "$(play)",
          "description": "the start script"
        },
        {
          "name": "dev",
          "command": "npm run dev",
          "icon": "$(watch)",
          "description": "watch mode (Ctrl+C to stop)"
        },
        {
          "name": "test",
          "command": "npm test",
          "icon": "$(beaker)",
          "description": "tests"
        },
        {
          "name": "typecheck",
          "command": "npx --no-install tsc --noEmit",
          "icon": "$(symbol-interface)",
          "description": "type check with the local TypeScript (warns if not installed)"
        },
        {
          "name": "lint",
          "command": "npm run lint",
          "icon": "$(shield)",
          "description": "eslint"
        },
        {
          "name": "outdated",
          "command": "npm outdated",
          "icon": "$(clock)",
          "description": "outdated"
        },
        {
          "name": "audit fix",
          "command": "npm audit fix",
          "icon": "$(shield)",
          "confirm": "Package versions will change. Continue?",
          "description": "audit fix"
        },
        {
          "name": "clean node_modules",
          "command": "{rm} node_modules",
          "icon": "$(trash)",
          "confirm": "node_modules will be deleted, a reinstall will be needed. Continue?",
          "description": "deletes the dependency folder"
        },
        {
          "name": "link global",
          "command": "npm link",
          "icon": "$(link)",
          "argsPrompt": "package name (e.g. my-lib)",
          "description": "link"
        }
      ]
    },
    {
      "name": "Git",
      "summary": "status, branches, commit, push",
      "icon": "$(source-control)",
      "color": "#F14E32",
      "commands": [
        {
          "name": "init",
          "command": "git init",
          "icon": "$(new-folder)",
          "description": "make this folder a repository"
        },
        {
          "name": "default branch",
          "command": "git config --global init.defaultBranch",
          "icon": "$(symbol-variable)",
          "argsPrompt": "branch name (e.g. main)",
          "description": "sets the branch name new repositories start on (Git asks about this on every init)",
          "confirm": "This changes the branch name for every new repository on this machine. Continue?"
        },
        {
          "name": "status",
          "command": "git status",
          "icon": "$(source-control)",
          "description": "working tree"
        },
        {
          "name": "diff",
          "command": "git diff",
          "icon": "$(git-compare)",
          "description": "shows the changes"
        },
        {
          "name": "log",
          "command": "git log --oneline --graph -20",
          "icon": "$(history)",
          "description": "last 20 commits"
        },
        {
          "name": "stage all",
          "command": "git add -A",
          "icon": "$(cloud-download)",
          "description": "stages every change"
        },
        {
          "name": "commit",
          "command": "git commit -m",
          "icon": "$(git-commit)",
          "argsPrompt": "commit message",
          "argsSingle": true,
          "description": "commit with a message"
        },
        {
          "name": "push",
          "command": "git push",
          "icon": "$(cloud-upload)",
          "confirm": "Changes will be pushed to the remote. Continue?",
          "description": "push to the remote"
        },
        {
          "name": "remotes",
          "command": "git remote -v",
          "icon": "$(link)",
          "description": "shows the remotes — empty means push has nowhere to go"
        },
        {
          "name": "add remote",
          "command": "git remote add origin",
          "icon": "$(cloud-upload)",
          "argsPrompt": "repository URL (e.g. https://github.com/you/aaa.git)",
          "confirm": "This links this folder to a remote repository. Continue?",
          "description": "links this folder to a remote (create an EMPTY repo on GitHub first)"
        },
        {
          "name": "push first time",
          "command": "git push -u origin",
          "icon": "$(rocket)",
          "argsPrompt": "branch name (e.g. main)",
          "confirm": "This will publish the commits to the remote. Continue?",
          "description": "first push: uploads the history and remembers the branch"
        },
        {
          "name": "pull",
          "command": "git pull",
          "icon": "$(cloud-download)",
          "confirm": "May conflict with local changes. Continue?",
          "description": "fetch from the remote"
        },
        {
          "name": "fetch",
          "command": "git fetch --all --prune",
          "icon": "$(sync)",
          "description": "refresh remotes, drop deleted branches"
        },
        {
          "name": "branches",
          "command": "git branch -a",
          "icon": "$(git-branch)",
          "description": "local and remote branches"
        },
        {
          "name": "switch branch",
          "command": "git checkout",
          "icon": "$(git-branch)",
          "argsPrompt": "branch or file name",
          "description": "switch branch / restore file"
        },
        {
          "name": "new branch",
          "command": "git checkout -b",
          "icon": "$(git-branch)",
          "argsPrompt": "new branch name",
          "description": "create and switch to a branch"
        },
        {
          "name": "stash",
          "command": "git stash",
          "icon": "$(git-stash)",
          "description": "stashes the changes"
        },
        {
          "name": "unstash",
          "command": "git stash pop",
          "icon": "$(git-stash)",
          "description": "restores the stash"
        },
        {
          "name": "undo last commit",
          "command": "git reset --soft HEAD~1",
          "icon": "$(debug-rerun)",
          "confirm": "The last commit will be undone (files are kept). Continue?",
          "description": "soft reset"
        },
        {
          "name": "clone",
          "command": "git clone",
          "icon": "$(repo)",
          "argsPrompt": "repository URL",
          "description": "clone from the remote"
        }
      ]
    },
    {
      "name": "Firebase",
      "summary": "login, deploy, emulators",
      "icon": "$(broadcast)",
      "color": "#FFCA28",
      "commands": [
        {
          "name": "log in",
          "command": "firebase login",
          "icon": "$(account)",
          "description": "opens a browser session"
        },
        {
          "name": "log out",
          "command": "firebase logout",
          "icon": "$(sign-out)",
          "description": "closes the session"
        },
        {
          "name": "list projects",
          "command": "firebase projects:list",
          "icon": "$(list-ordered)",
          "description": "projects on the account"
        },
        {
          "name": "link project",
          "command": "firebase use",
          "icon": "$(link)",
          "argsPrompt": "project ID",
          "description": "links the folder to a project"
        },
        {
          "name": "deploy hosting",
          "command": "firebase deploy --only hosting",
          "icon": "$(cloud-upload)",
          "confirm": "Hosting will be published to production. Continue?",
          "description": "publishes the static site"
        },
        {
          "name": "deploy functions",
          "command": "firebase deploy --only functions",
          "icon": "$(rocket)",
          "confirm": "Functions will be published to production. Continue?",
          "description": "publishes the server functions"
        },
        {
          "name": "deploy rules",
          "command": "firebase deploy --only firestore:rules",
          "icon": "$(shield)",
          "confirm": "Firestore rules will be published. Continue?",
          "description": "rules + indexes"
        },
        {
          "name": "emulators",
          "command": "firebase emulators:start",
          "icon": "$(beaker)",
          "description": "local emulators (Ctrl+C to stop)"
        },
        {
          "name": "function logs",
          "command": "firebase functions:log",
          "icon": "$(history)",
          "description": "live function logs"
        },
        {
          "name": "init",
          "command": "firebase init",
          "icon": "$(gear)",
          "confirm": "firebase.json will be created or written in this folder. Continue?",
          "description": "configuration (interactive)"
        }
      ]
    },
    {
      "name": "Docker",
      "icon": "$(package)",
      "color": "#2496ED",
      "summary": "build, start, logs, clean",
      "commands": [
        {
          "name": "build",
          "command": "docker compose build",
          "icon": "$(package)",
          "description": "builds the images"
        },
        {
          "name": "init",
          "command": "docker compose up -d",
          "icon": "$(play)",
          "description": "starts in the background"
        },
        {
          "name": "down",
          "command": "docker compose down",
          "icon": "$(discard)",
          "description": "stops and removes the containers"
        },
        {
          "name": "logs",
          "command": "docker compose logs -f",
          "icon": "$(output)",
          "description": "follow the logs live (Ctrl+C to stop)"
        },
        {
          "name": "running",
          "command": "docker ps",
          "icon": "$(server)",
          "description": "running containers"
        },
        {
          "name": "shell",
          "command": "docker compose exec",
          "icon": "$(terminal)",
          "argsPrompt": "service name (e.g. api)",
          "description": "opens a shell inside a service"
        },
        {
          "name": "images",
          "command": "docker images",
          "icon": "$(files)",
          "description": "local images"
        },
        {
          "name": "clean",
          "command": "docker compose down -v --remove-orphans",
          "icon": "$(trash)",
          "confirm": "The project containers, volumes and networks will be deleted. Continue?",
          "description": "deletes the containers and volumes"
        },
        {
          "name": "prune system",
          "command": "docker system prune -a",
          "icon": "$(warning)",
          "confirm": "All unused images, containers and networks will be deleted. This cannot be undone. Continue?",
          "description": "deletes every unused resource"
        }
      ]
    },
    {
      "name": "GitHub CLI",
      "icon": "$(source-control)",
      "color": "#8B949E",
      "summary": "PRs, issues and runs",
      "commands": [
        {
          "name": "status",
          "command": "gh status",
          "icon": "$(source-control)",
          "description": "PR and issue summary"
        },
        {
          "name": "list PRs",
          "command": "gh pr list",
          "icon": "$(git-pull-request)",
          "description": "open PRs"
        },
        {
          "name": "create PR",
          "command": "gh pr create",
          "icon": "$(git-pull-request)",
          "description": "opens a new PR"
        },
        {
          "name": "view PR",
          "command": "gh pr view",
          "icon": "$(git-compare)",
          "description": "opens an existing PR"
        },
        {
          "name": "checkout PR",
          "command": "gh pr checkout",
          "icon": "$(cloud-download)",
          "argsPrompt": "branch name or PR number",
          "description": "checks out the branch of a PR"
        },
        {
          "name": "create issue",
          "command": "gh issue create",
          "icon": "$(edit)",
          "description": "a new issue"
        },
        {
          "name": "list issues",
          "command": "gh issue list",
          "icon": "$(list-ordered)",
          "description": "open issues"
        },
        {
          "name": "view repository",
          "command": "gh repo view",
          "icon": "$(repo)",
          "description": "repository details"
        },
        {
          "name": "runs",
          "command": "gh run list",
          "icon": "$(history)",
          "description": "Actions workflow runs"
        },
        {
          "name": "watch run",
          "command": "gh run watch",
          "icon": "$(watch)",
          "argsPrompt": "run number",
          "description": "follow a run live"
        },
        {
          "name": "create release",
          "command": "gh release create",
          "icon": "$(tag)",
          "argsPrompt": "release tag (e.g. v1.0.0)",
          "confirm": "The release will be published. Continue?",
          "description": "creates a new release"
        },
        {
          "name": "session",
          "command": "gh auth status",
          "icon": "$(account)",
          "description": "login status"
        }
      ]
    },
    {
      "name": "PostgreSQL",
      "icon": "$(database)",
      "color": "#4169E1",
      "summary": "connect, query, back up",
      "commands": [
        {
          "name": "connect",
          "command": "psql -U postgres",
          "icon": "$(terminal)",
          "description": "psql shell (Ctrl+C to exit)"
        },
        {
          "name": "databases",
          "command": "psql -l",
          "icon": "$(list-ordered)",
          "description": "lists the databases"
        },
        {
          "name": "run query",
          "command": "psql -c",
          "icon": "$(search)",
          "argsPrompt": "SQL (e.g. SELECT * FROM users LIMIT 10)",
          "argsSingle": true,
          "description": "runs a single query then exits"
        },
        {
          "name": "back up",
          "command": "pg_dump",
          "icon": "$(archive)",
          "argsPrompt": "database name",
          "description": "takes a SQL dump"
        },
        {
          "name": "restore",
          "command": "psql -f",
          "icon": "$(cloud-upload)",
          "argsPrompt": "SQL file",
          "description": "runs a SQL file"
        },
        {
          "name": "table sizes",
          "command": "psql -c \"\\dt+\"",
          "icon": "$(table)",
          "description": "tables and their sizes"
        },
        {
          "name": "watch locks",
          "command": "psql -c \"SELECT * FROM pg_stat_activity\"",
          "icon": "$(clock)",
          "description": "open queries and locks"
        }
      ]
    },
    {
      "name": "Go",
      "icon": "$(server-environment)",
      "color": "#00ADD8",
      "summary": "test, build, mod tidy",
      "commands": [
        {
          "name": "test",
          "command": "go test ./...",
          "icon": "$(beaker)",
          "description": "all tests"
        },
        {
          "name": "build",
          "command": "go build ./...",
          "icon": "$(package)",
          "description": "compiles"
        },
        {
          "name": "run",
          "command": "go run",
          "icon": "$(play)",
          "argsPrompt": "file path (e.g. ./cmd/api)",
          "description": "runs it (Ctrl+C to stop)"
        },
        {
          "name": "mod tidy",
          "command": "go mod tidy",
          "icon": "$(sync)",
          "description": "tidies the dependencies"
        },
        {
          "name": "vet",
          "command": "go vet ./...",
          "icon": "$(shield)",
          "description": "static checks"
        },
        {
          "name": "check format",
          "command": "gofmt -l .",
          "icon": "$(check)",
          "description": "lists the files that need formatting"
        },
        {
          "name": "write format",
          "command": "gofmt -w .",
          "icon": "$(paintcan)",
          "description": "applies the formatting"
        },
        {
          "name": "lint",
          "command": "golangci-lint run",
          "icon": "$(shield)",
          "description": "golangci-lint"
        },
        {
          "name": "add package",
          "command": "go get",
          "icon": "$(cloud-download)",
          "argsPrompt": "package (e.g. github.com/gin-gonic/gin@latest)",
          "description": "adds a dependency"
        },
        {
          "name": "clear cache",
          "command": "go clean -cache",
          "icon": "$(trash)",
          "confirm": "The build cache will be deleted. Continue?",
          "description": "empties the cache"
        }
      ]
    },
    {
      "name": "Rust",
      "icon": "$(gear)",
      "color": "#DEA584",
      "summary": "cargo: test, clippy, fmt",
      "commands": [
        {
          "name": "test",
          "command": "cargo test",
          "icon": "$(beaker)",
          "description": "all tests"
        },
        {
          "name": "build",
          "command": "cargo build",
          "icon": "$(package)",
          "description": "debug build"
        },
        {
          "name": "release build",
          "command": "cargo build --release",
          "icon": "$(rocket)",
          "description": "optimised build"
        },
        {
          "name": "run",
          "command": "cargo run",
          "icon": "$(play)",
          "description": "runs it (Ctrl+C to stop)"
        },
        {
          "name": "clippy",
          "command": "cargo clippy",
          "icon": "$(shield)",
          "description": "linter"
        },
        {
          "name": "format",
          "command": "cargo fmt",
          "icon": "$(paintcan)",
          "description": "formats the code"
        },
        {
          "name": "check",
          "command": "cargo check",
          "icon": "$(check)",
          "description": "type checks without building"
        },
        {
          "name": "add crate",
          "command": "cargo add",
          "icon": "$(cloud-download)",
          "argsPrompt": "crate and optional flags (e.g. serde --features derive)",
          "description": "adds a dependency"
        },
        {
          "name": "update",
          "command": "cargo update",
          "icon": "$(sync)",
          "description": "updates the dependencies"
        },
        {
          "name": "clean",
          "command": "cargo clean",
          "icon": "$(trash)",
          "confirm": "The target/ directory will be deleted and the next build will be slow. Continue?",
          "description": "deletes the build outputs"
        }
      ]
    },
    {
      "name": "Kubernetes",
      "icon": "$(vm)",
      "color": "#326CE5",
      "summary": "pods, logs, exec, apply",
      "commands": [
        {
          "name": "list pods",
          "command": "kubectl get pods",
          "icon": "$(list-ordered)",
          "description": "lists the pods"
        },
        {
          "name": "list services",
          "command": "kubectl get svc",
          "icon": "$(server)",
          "description": "lists the services"
        },
        {
          "name": "everything",
          "command": "kubectl get all -A",
          "icon": "$(list-selection)",
          "description": "all resources, all namespaces"
        },
        {
          "name": "describe pod",
          "command": "kubectl describe pod",
          "icon": "$(symbol-class)",
          "argsPrompt": "pod name",
          "description": "pod details and events"
        },
        {
          "name": "follow logs",
          "command": "kubectl logs -f",
          "icon": "$(output)",
          "argsPrompt": "pod name",
          "description": "follow the logs live"
        },
        {
          "name": "shell",
          "command": "kubectl exec -it",
          "icon": "$(terminal)",
          "argsPrompt": "pod name",
          "description": "opens a shell inside a pod"
        },
        {
          "name": "port forward",
          "command": "kubectl port-forward",
          "icon": "$(link)",
