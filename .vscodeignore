# package.json ve kök dosyaları paketlenmez — vsce bunları zaten ekliyor.
#
# `npm run build` (vscode:prepublish) dist/ üretir, kaynak .ts dosyaları
# çalışma zamanında gerekmiyor.
node_modules/**
src/**
test/**
scripts/**
out/**
.vscode/**
.vscode-test/**

tsconfig.json
vitest.config.mts
esbuild.mjs
PLAN.md
docs/**
AGENTS.md
.gitignore

# Kaynak haritası 214 KB — paketin yarısından fazlası. Yerelde hata ayıklamak
# için gerekli, ama kurulan eklentide kullanıcıya hiçbir işe yaramıyor.
dist/**/*.map

*.vsix

# Düzenleme dosyası kök dizinde üretiliyorsa paketlenmesin.
/cmdkit-groups.json