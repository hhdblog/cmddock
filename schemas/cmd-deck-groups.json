{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cmd Deck komut listesi",
  "description": "cmd-deck-groups.json dosyasının içeriği. `settings.json` içindeki `cmdDeck.groups` ile aynı biçimdedir. Platform belirteçleri ({python}, {venv}, {venvpy}, {rm}) çalıştırma anında çözülür, burada olduğu gibi yazılır.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "name",
      "commands"
    ],
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "description": "Grup adı, menüde başlık olarak görünür."
      },
      "icon": {
        "type": "string",
        "description": "Kodikon adı (\"zap\") veya \"$(zap)\" biçiminde. Varsayılan: $(terminal)."
      },
      "color": {
        "type": "string",
        "description": "Durum çubuğundaki bu grubun ön plan rengi. \"#4B8BBE\" gibi hex ya da \"charts.blue\" gibi tema rengi adı."
      },
      "commands": {
        "type": "array",
        "description": "Grup içindeki komutlar. Boş bırakılırsa grup sessizce yok sayılır, o yüzden en az bir komut olmalı.",
        "items": {
          "type": "object",
          "required": [
            "name",
            "command"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Komutun menüde görünen adı."
            },
            "command": {
              "type": "string",
              "description": "Çalıştırılacak shell komutu."
            },
            "description": {
              "type": "string",
              "description": "Sağda görünen açıklama."
            },
            "icon": {
              "type": "string",
              "description": "Kodikon adı (\"play\") veya \"$(play)\" biçiminde."
            },
            "confirm": {
              "type": [
                "string",
                "boolean"
              ],
              "description": "true ya da bir metin ise çalıştırmadan önce onay ister."
            },
            "argsPrompt": {
              "type": "string",
              "description": "Çalıştırmadan önce kullanıcıdan argüman sorulur."
            },
            "clear": {
              "type": "boolean",
              "description": "true ise terminal temizlenerek çalıştırılır."
            }
          }
        },
        "minItems": 1
      }
    }
  }
}
